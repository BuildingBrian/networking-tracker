# ---------------------------------------------------------------------------
# Copy this file to .env.local and fill in the values from the Neon Console.
# .env.local is git-ignored. Never commit real values.
# ---------------------------------------------------------------------------

# --- Public (safe to expose to the browser) --------------------------------
# These two HTTPS endpoints are designed to be public. Row Level Security in
# Postgres is what protects the data behind them, not the secrecy of the URL.

# Neon Console -> Auth
NEXT_PUBLIC_NEON_AUTH_URL=https://ep-example-123456.neonauth.c-2.us-west-2.aws.neon.tech/neondb/auth

# Neon Console -> Data API
NEXT_PUBLIC_NEON_DATA_API_URL=https://ep-example-123456.apirest.c-2.us-west-2.aws.neon.tech/neondb/rest/v1


# --- Server-only (must never reach the browser) ----------------------------

# The Neon Auth endpoint this app's /api/auth route proxies to. Same value as
# NEXT_PUBLIC_NEON_AUTH_URL; kept separate so server code never depends on a
# NEXT_PUBLIC_ variable.
NEON_AUTH_BASE_URL=https://ep-example-123456.neonauth.c-2.us-west-2.aws.neon.tech/neondb/auth

# Signs the httpOnly session cookie. Minimum 32 characters.
# Generate one with:  openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=replace-with-at-least-32-random-characters

# Postgres connection string. Used ONLY to apply db/schema.sql from your
# machine. The running application never reads it — all user data goes through
# the Data API under the signed-in user's own token, so RLS applies.
# Never expose this to the browser and never commit it.
DATABASE_URL=postgresql://user:password@ep-example-123456.us-west-2.aws.neon.tech/neondb?sslmode=require
